# Local development only. Copy to .env and replace placeholders; never commit .env.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=kishan_portfolio

AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=replace_with_your_google_ai_studio_key
# For local Ollama instead, set AI_PROVIDER=ollama and configure OLLAMA_BASE_URL.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# For email notifications, use a sender verified in your Brevo account.
BREVO_API_KEY=
BREVO_FROM_EMAIL=your-verified-sender@example.com
EMAIL_FROM_NAME=Kishan Kumar Portfolio
EMAIL_REPLY_TO=
OWNER_EMAIL=k.kishankg120@gmail.com

# Generate a unique secret of at least 32 characters for /admin.
ADMIN_KEY=replace_with_a_long_random_secret_at_least_32_characters
CORS_ORIGINS=http://localhost:3000

CONTACT_HOURLY_LIMIT=5
CONTACT_RETENTION_DAYS=7
CHAT_RETENTION_DAYS=7
CHAT_DAILY_LIMIT=30
EMAIL_RETRY_ATTEMPTS=3
